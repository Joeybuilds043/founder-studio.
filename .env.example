# Default free-tier provider
AI_PROVIDER=gemini
GEMINI_API_KEY=paste_your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI alternative (set AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cost estimate settings (Gemini free tier: set both to 0)
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
PANEL_CONCURRENCY=2
